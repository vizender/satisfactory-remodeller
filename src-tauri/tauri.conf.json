{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Satisfactory Remodeller",
  "version": "1.0.0",
  "identifier": "com.victorlegall.satisfactory-remodeller",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Satisfactory : Remodeller",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "vizender",
    "copyright": "Copyright © 2026 vizender",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Planificateur de chaînes de production façon Satisfactory.",
    "longDescription": "Satisfactory : Remodeller — graphe de production, débits, horloges et bilan énergie. Logiciel open source (MIT) par vizender ; Satisfactory est une marque déposée par Coffee Stain Studios AB.",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
