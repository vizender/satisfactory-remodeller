{
  "name": "satisfactory-remodeller",
  "private": true,
  "version": "1.3.8",
  "type": "module",
  "description": "Satisfactory : Remodeller — planificateur d’usines (web + React, Tauri optionnel)",
  "author": "vizender",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:browser": "vite --open",
    "dev:desktop": "tauri dev",
    "dev:web": "vite",
    "gen:recipes": "tsx scripts/generateRecipeIndex.ts",
    "download:icons": "tsx scripts/downloadWikiIcons.ts",
    "report:icons": "tsx scripts/reportRecipeIcons.ts",
    "prebuild": "npm run gen:recipes",
    "predev": "npm run gen:recipes",
    "build": "tsc && vite build",
    "build:desktop": "tauri build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@xyflow/react": "^12.9.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.9.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
